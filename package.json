{
  "name": "memoria",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "pnpm typecheck && pnpm test:bootstrap && turbo run build",
    "start": "turbo run start --env-mode=loose",
    "test:e2e": "pnpm test:auth:e2e && pnpm test:pages:e2e && node --env-file=.env scripts/test-session1.mjs",
    "test:auth:e2e": "node scripts/build-server.mjs api --auth-e2e && node --env-file=.env apps/api/dist/auth.e2e.mjs",
    "test:pages:e2e": "node scripts/build-server.mjs api --pages-e2e && node --env-file=.env apps/api/dist/pages.e2e.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:bootstrap && pnpm test",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test:bootstrap": "node scripts/build-server.mjs api --probe && node apps/api/dist/bootstrap-probe.mjs",
    "test": "vitest run",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "proof:collab": "node scripts/proof-collab.mjs",
    "proof:collab:2bis": "node scripts/proof-collab-2bis.mjs",
    "db:generate": "pnpm --filter @memoria/db generate",
    "db:migrate": "pnpm --filter @memoria/db migrate",
    "openapi:generate": "pnpm --filter @memoria/contracts openapi && prettier --write docs/api/openapi.json",
    "hooks:install": "lefthook install",
    "secrets:staged": "node scripts/check-staged.mjs",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "proof:collab:incremental": "node scripts/proof-collab-incremental.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
