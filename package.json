{
  "name": "memoria",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "storage:local": "node scripts/storage-local.mjs",
    "storage:init": "node scripts/init-storage.mjs",
    "test:storage:rustfs": "node scripts/test-storage-alternatives.mjs --provider rustfs-1.0.4",
    "test:files:e2e": "node scripts/build-server.mjs api --files-e2e && node --env-file=.env apps/api/dist/files.e2e.mjs",
    "measure:files": "node scripts/test-collab.mjs --suite files-load",
    "build:storage:fixture": "node scripts/build-storage-fixture.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:databases:browser": "node --env-file=.env --use-system-ca scripts/test-databases-browser.mjs",
    "proof:databases": "node scripts/proof-databases.mjs",
    "measure:rights": "node scripts/measure-rights.mjs",
    "test:shares:browser": "node --env-file=.env --use-system-ca scripts/test-shares-browser.mjs",
    "test:shares:e2e": "node scripts/build-server.mjs api --shares-e2e && node --env-file=.env apps/api/dist/shares.e2e.mjs",
    "test:auth:adversarial": "node scripts/build-server.mjs api --adversarial-e2e && node --env-file=.env apps/api/dist/adversarial.e2e.mjs",
    "test:auth:adversarial:browser": "node --env-file=.env --use-system-ca scripts/test-auth-adversarial-browser.mjs",
    "test:auth:cache": "node scripts/build-server.mjs api --cache-policy-e2e && node --env-file=.env apps/api/dist/cache-policy.e2e.mjs",
    "test:auth:cache:browser": "node --env-file=.env --use-system-ca scripts/test-auth-cache-browser.mjs",
    "test:auth:limits": "node scripts/build-server.mjs api --rate-limits-e2e && node --env-file=.env apps/api/dist/rate-limits.e2e.mjs",
    "test:auth:limits:browser": "node --env-file=.env --use-system-ca scripts/test-auth-limits-browser.mjs",
    "admin:reset-factor": "node scripts/admin-reset-factor.mjs",
    "dev": "turbo run dev --env-mode=loose",
    "build": "pnpm typecheck && pnpm test:bootstrap && turbo run build",
    "start": "turbo run start --env-mode=loose",
    "test:e2e": "pnpm test:auth:e2e && pnpm test:pages:e2e && node --env-file=.env scripts/test-session1.mjs",
    "test:auth:e2e": "node scripts/build-server.mjs api --auth-e2e && node --env-file=.env apps/api/dist/auth.e2e.mjs",
    "test:auth:strong": "node scripts/build-server.mjs api --strong-auth-e2e && node --env-file=.env apps/api/dist/strong-auth.e2e.mjs",
    "test:auth:workspace": "node scripts/build-server.mjs api --workspace-security-e2e && node --env-file=.env apps/api/dist/workspace-security.e2e.mjs",
    "test:auth:strong:browser": "node --env-file=.env --use-system-ca scripts/test-auth-strong-browser.mjs",
    "test:pages:e2e": "node scripts/build-server.mjs api --pages-e2e && node --env-file=.env apps/api/dist/pages.e2e.mjs",
    "check": "pnpm hooks:check && pnpm lint && pnpm typecheck && pnpm test:bootstrap && pnpm test",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:bootstrap": "node scripts/build-server.mjs api --probe && node apps/api/dist/bootstrap-probe.mjs",
    "test": "vitest run",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "db:generate": "pnpm --filter @memoria/db generate",
    "db:migrate": "pnpm --filter @memoria/db migrate",
    "openapi:generate": "pnpm --filter @memoria/contracts openapi && prettier --write docs/api/openapi.json",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:check": "node scripts/check-git-hooks.mjs",
    "secrets:staged": "node scripts/check-staged.mjs",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "test:collab:e2e": "node scripts/test-collab.mjs",
    "dev:collab": "node --env-file=.env scripts/dev-collaboration.mjs",
    "test:collab:browser": "node --env-file=.env --use-system-ca scripts/test-collab-browser.mjs",
    "test:auth:recovery": "node scripts/build-server.mjs worker --reset-factor && node scripts/build-server.mjs api --recovery-e2e && node --env-file=.env apps/api/dist/recovery.e2e.mjs",
    "test:auth:recovery:browser": "node --env-file=.env --use-system-ca scripts/test-auth-recovery-browser.mjs",
    "test:sharing:e2e": "node scripts/build-server.mjs api --sharing-e2e && node --env-file=.env apps/api/dist/sharing.e2e.mjs",
    "test:invitations:browser": "node --env-file=.env --use-system-ca scripts/test-invitations-browser.mjs",
    "test:invitations:atomicity": "node scripts/build-server.mjs api --invitations-atomicity-e2e && node --env-file=.env apps/api/dist/invitations-atomicity.e2e.mjs",
    "test:invitations:e2e": "node scripts/build-server.mjs api --invitations-e2e && node --env-file=.env apps/api/dist/invitations.e2e.mjs",
    "test:storage:alternatives": "node scripts/test-storage-alternatives.mjs",
    "test:files:boundaries": "node scripts/test-collab.mjs --suite files && node scripts/test-collab.mjs --suite file-cells && node scripts/test-collab.mjs --suite files-wire",
    "test:files:races": "node scripts/build-server.mjs api --file-races-e2e && node --env-file=.env apps/api/dist/file-races.e2e.mjs",
    "profile:files": "node scripts/test-collab.mjs --suite file-projection-profile",
    "test:files:recovery": "node scripts/build-server.mjs worker --file-accounting && node scripts/build-server.mjs api --file-recovery-e2e && node --env-file=.env apps/api/dist/file-recovery.e2e.mjs",
    "files:accounting": "node scripts/run-file-accounting.mjs",
    "test:files:browser": "node scripts/build-server.mjs api --files-browser-e2e && node --env-file=.env --use-system-ca apps/api/dist/files-browser.e2e.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "test:docker:isolation": "node --test scripts/docker-test-isolation.e2e.mjs",
    "files:validator:build": "node scripts/build-file-validator.mjs",
    "test:files:images": "node --test scripts/test-file-images.mjs",
    "measure:files:images": "node scripts/measure-file-images.mjs",
    "test:files:reading": "node scripts/build-server.mjs api --file-reading-e2e && node --env-file=.env apps/api/dist/file-reading.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsqr": "1.4.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
