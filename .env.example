# Template only. Run pnpm env:init; never commit .env.
NODE_ENV=development
APP_ORIGIN=https://localhost
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
# Explicitly list the proxy IP/CIDR in production; local loopback is the safe default.
TRUSTED_PROXY_CIDRS=loopback
BETTER_AUTH_URL=https://localhost
BETTER_AUTH_SECRET=
WEBAUTHN_RP_ID=localhost
DATA_ENCRYPTION_KEY=
POSTGRES_USER=memoria
POSTGRES_DB=memoria
POSTGRES_PASSWORD=
DATABASE_URL=
MINIO_ROOT_USER=memoria-local
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=https://uploads.localhost:9443
S3_REGION=us-east-1
S3_BUCKET=memoria
S3_FORCE_PATH_STYLE=true
# Production: dedicated least-privilege S3 credentials; never use the root account.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Memoria <noreply@localhost>
TRASH_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
DELIVERY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_HOURS=24
COMPLETED_JOB_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=30
ORPHAN_FILE_RETENTION_HOURS=24
FILES_MAX_BYTES=5368709120
FILES_WORKSPACE_BYTES=268435456000
FILES_PART_BYTES=16777216
FILES_URL_SECONDS=120
FILES_COPY_BYTES=21474836480
FILES_STAGING_BYTES=68719476736
# Logical total (originals/derivative reservations + staging + temporary copies).
# Set to the capacity actually allocated to objects; provider overhead/backups are additional.
FILES_CAPACITY_BYTES=536870912000
DOWNLOAD_URL_TTL_SECONDS=60
PAGE_VERSION_POLL_INTERVAL_SECONDS=15
MFA_GRACE_DAYS=7
STRONG_SESSION_MAX_AGE_SECONDS=600
AUTH_EMAIL_MAX_15M=3
AUTH_EMAIL_MAX_DAY=10
AUTH_COUNTER_RETENTION_HOURS=24
INVITATION_VALIDITY_DAYS=7
INVITATION_RETENTION_DAYS=30
INVITATION_MAIL_TTL_HOURS=24
WORKSPACE_MAX_MEMBERS=100
WORKSPACE_MAX_PENDING_INVITATIONS=500
GUEST_MAX_SHARED_ROOTS=100
WORKSPACE_MAX_SHARES=5000
WEBHOOK_INTERNAL_ALLOWLIST=
WEBHOOK_DISABLE_AFTER_FAILURES=10
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_MAX_SECONDS=3600

# Collaboration (private processes; WSS Caddy integration follows in 3b)
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3003
COLLAB_INTERNAL_HOST=127.0.0.1
COLLAB_INTERNAL_PORT=3004
COLLAB_INTERNAL_URL=http://127.0.0.1:3004/internal/collaboration
COLLAB_INTERNAL_SECRET=
# Admission budget: proportional room classes + shared pool/projector (not an RSS cap).
# Optional COLLAB_VALIDATION_WORKERS: min(4, max(1, floor(available CPUs / 2))), range 1..8.
COLLAB_REPLICA_MEMORY_BYTES=1073741824
COLLAB_REPLICA_IDLE_MS=300000
COLLAB_MAX_SOCKETS=500
COLLAB_MAX_USER_SOCKETS=20
COLLAB_MAX_UNAUTHENTICATED=100
COLLAB_ROOM_QUEUE_BYTES=8388608
COLLAB_ROOM_QUEUE_MESSAGES=100
COLLAB_TOTAL_QUEUE_BYTES=67108864
COLLAB_UPDATES_PER_SECOND=30
COLLAB_UPDATE_BURST=60
