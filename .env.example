# Template only. Run pnpm env:init; never commit .env.
NODE_ENV=development
APP_ORIGIN=https://localhost
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
# Explicitly list the proxy IP/CIDR in production; local loopback is the safe default.
TRUSTED_PROXY_CIDRS=loopback
BETTER_AUTH_URL=https://localhost
BETTER_AUTH_SECRET=
WEBAUTHN_RP_ID=localhost
DATA_ENCRYPTION_KEY=
POSTGRES_USER=memoria
POSTGRES_DB=memoria
POSTGRES_PASSWORD=
DATABASE_URL=
MINIO_ROOT_USER=memoria-local
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=https://localhost:9443
S3_REGION=us-east-1
S3_BUCKET=memoria
S3_FORCE_PATH_STYLE=true
# Production: dedicated least-privilege S3 credentials; never use the root account.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Memoria <noreply@localhost>
TRASH_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
DELIVERY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_HOURS=24
COMPLETED_JOB_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=30
ORPHAN_FILE_RETENTION_HOURS=24
FILE_MAX_BYTES=52428800
DOWNLOAD_URL_TTL_SECONDS=60
PAGE_VERSION_POLL_INTERVAL_SECONDS=15
MFA_GRACE_DAYS=7
STRONG_SESSION_MAX_AGE_SECONDS=600
WEBHOOK_INTERNAL_ALLOWLIST=
WEBHOOK_DISABLE_AFTER_FAILURES=10
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_MAX_SECONDS=3600
