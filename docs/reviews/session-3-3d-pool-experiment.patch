diff --git a/apps/collab/src/service/validation-pool.ts b/apps/collab/src/service/validation-pool.ts
new file mode 100644
index 0000000..dba8437
--- /dev/null
+++ b/apps/collab/src/service/validation-pool.ts
@@ -0,0 +1,137 @@
+import { Worker } from 'node:worker_threads';
+import { availableParallelism } from 'node:os';
+import { CandidateRejected } from '../validator.ts';
+
+export const defaultValidationWorkers = () =>
+  Math.max(1, Math.min(4, Math.floor(availableParallelism() / 2)));
+type Reply = { result: unknown; elapsed: number };
+type Job = {
+  id: number;
+  replica: number;
+  operation: string;
+  data: object;
+  deadline: number;
+  resolve: (reply: Reply) => void;
+  reject: (error: Error) => void;
+};
+type Slot = {
+  worker: Worker;
+  online: boolean;
+  failed: boolean;
+  replicas: Map<number, () => void>;
+  queue: Job[];
+  active?: Job;
+  timer?: ReturnType<typeof setTimeout>;
+};
+
+/** Page affinity; one dispatched operation per worker, bounded host-side queue. */
+export class ValidationPool {
+  private slots: Slot[] = [];
+  private nextId = 0;
+  private stopped = false;
+  constructor(
+    readonly size = defaultValidationWorkers(),
+    readonly memoryMiB = 256,
+  ) {
+    if (!Number.isInteger(size) || size < 1 || size > 16)
+      throw new Error('Invalid worker pool size');
+  }
+  private createSlot() {
+    const worker = new Worker(new URL('./incremental-worker.mjs', import.meta.url), {
+      resourceLimits: { maxOldGenerationSizeMb: this.memoryMiB, maxYoungGenerationSizeMb: 16 },
+    });
+    const slot: Slot = { worker, online: false, failed: false, replicas: new Map(), queue: [] };
+    this.slots.push(slot);
+    worker.once('online', () => {
+      slot.online = true;
+      this.dispatch(slot);
+    });
+    worker.on('error', (error) => this.fail(slot, error));
+    worker.on('exit', () => this.fail(slot, new Error('Replica worker exited')));
+    worker.on(
+      'message',
+      (message: Reply & { id: number; error?: string; validation?: boolean }) => {
+        const job = slot.active;
+        if (!job || job.id !== message.id) {
+          this.fail(slot, new Error('Worker reply mismatch'));
+          return;
+        }
+        clearTimeout(slot.timer);
+        delete slot.active;
+        if (message.error)
+          job.reject(
+            message.validation ? new CandidateRejected(message.error) : new Error(message.error),
+          );
+        else job.resolve(message);
+        this.dispatch(slot);
+      },
+    );
+    return slot;
+  }
+  private fail(slot: Slot, error: Error) {
+    if (slot.failed) return;
+    slot.failed = true;
+    clearTimeout(slot.timer);
+    slot.active?.reject(error);
+    delete slot.active;
+    for (const job of slot.queue.splice(0)) job.reject(error);
+    for (const fault of slot.replicas.values()) fault();
+    slot.replicas.clear();
+    void slot.worker.terminate();
+  }
+  private dispatch(slot: Slot) {
+    if (!slot.online || slot.failed || slot.active) return;
+    const job = slot.queue.shift();
+    if (!job) return;
+    slot.active = job;
+    slot.timer = setTimeout(
+      () => this.fail(slot, new Error(`Replica budget exceeded (${job.deadline} ms)`)),
+      job.deadline,
+    );
+    slot.worker.postMessage({
+      id: job.id,
+      replicaId: job.replica,
+      operation: job.operation,
+      ...job.data,
+    });
+  }
+  allocate(onFault: () => void) {
+    if (this.stopped) throw new Error('Worker pool closed');
+    const live = this.slots.filter((s) => !s.failed);
+    const slot =
+      live.length < this.size
+        ? this.createSlot()
+        : live.sort((a, b) => a.replicas.size - b.replicas.size)[0]!;
+    const replica = ++this.nextId;
+    let closed = false;
+    slot.replicas.set(replica, onFault);
+    const request = (operation: string, data: object = {}, deadline = 250): Promise<Reply> => {
+      if (closed || this.stopped || slot.failed)
+        return Promise.reject(new Error('Replica worker unavailable'));
+      if (slot.queue.length >= 128)
+        return Promise.reject(new Error('Validation worker queue full'));
+      return new Promise((resolve, reject) => {
+        slot.queue.push({ id: ++this.nextId, replica, operation, data, deadline, resolve, reject });
+        this.dispatch(slot);
+      });
+    };
+    return {
+      request,
+      async close() {
+        if (closed) return;
+        try {
+          if (!slot.failed) await request('dispose', {}, 30000);
+        } finally {
+          closed = true;
+          slot.replicas.delete(replica);
+        }
+      },
+    };
+  }
+  async close() {
+    this.stopped = true;
+    for (const slot of this.slots) this.fail(slot, new Error('Worker pool closed'));
+    await Promise.all(this.slots.map((slot) => slot.worker.terminate()));
+    this.slots = [];
+  }
+}
