{
  log default {
    format filter {
      request>uri delete
      request>headers delete
      resp_headers delete
    }
  }
  servers :9443 {
    timeouts {
      read_header 10s
      read_body 120s
    }
  }
}

https://files.localhost {
  tls internal
  @reading path /v1/files/*
  handle @reading {
    reverse_proxy host.docker.internal:3005
  }
  handle {
    respond 404
  }
}

https://localhost {
  tls internal
  handle /collab {
    reverse_proxy host.docker.internal:3003
  }
  handle /api/health/collab {
    reverse_proxy host.docker.internal:3003
  }
  handle /api/health/worker {
    reverse_proxy host.docker.internal:3002
  }
  handle /api/auth/* {
    request_body {
      max_size 64KB
    }
    reverse_proxy host.docker.internal:3001
  }
  @api path /api/* /v1 /v1/* /openapi.json /docs /docs/*
  handle @api {
    request_body {
      max_size 1MB
    }
    reverse_proxy host.docker.internal:3001
  }
  handle {
    reverse_proxy host.docker.internal:3000
  }
}

https://uploads.localhost:9443 {
  tls internal
  @upload method POST PUT OPTIONS
  handle @upload {
    request_body {
      max_size 33619968
    }
    reverse_proxy rustfs:9000
  }
  handle {
    respond 403
  }
}
