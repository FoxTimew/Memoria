{
  "name": "@memoria/files",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-server.mjs files",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "dev": "node --env-file-if-exists=../../.env ../../scripts/build-server.mjs files --watch"
  },
  "dependencies": {
    "@memoria/auth": "workspace:*",
    "@memoria/db": "workspace:*",
    "@memoria/storage": "workspace:*",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
