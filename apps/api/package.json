    "@nestjs/platform-express": "12.2.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "fractional-indexing": "3.2.0",
    "nodemailer": "10.1.7",
