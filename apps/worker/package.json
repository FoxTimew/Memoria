{
  "name": "@memoria/worker",
  "private": true,
  "type": "module",
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@memoria/auth": "workspace:*",
    "@memoria/db": "workspace:*",
    "better-auth": "1.7.12",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-server.mjs worker",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "dev": "node --env-file-if-exists=../../.env ../../scripts/build-server.mjs worker --watch"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
